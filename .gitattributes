# Auto-detect text files and normalize line endings to LF in the repository.
* text=auto eol=lf

# Windows-specific scripts must keep CRLF or cmd.exe/Inno Setup can misparse them.
*.bat text eol=crlf
*.iss text eol=crlf
*.vbs text eol=crlf

# .NET / C#
*.cs      text diff=csharp
*.csproj  text
*.sln     text
*.slnx    text
*.json    text

# Angular / web
*.ts   text
*.html text
*.scss text
*.css  text
*.md   text

# Binary — never diff or line-ending-convert these
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.db   binary
*.pfx  binary
*.pem  binary
